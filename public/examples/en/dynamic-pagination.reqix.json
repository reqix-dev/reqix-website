  "groups": [],
  "rules": [
    {
      "id": "example-dynamic-pagination",
      "groupId": "",
      "name": "Dynamic pagination",
      "enabled": false,
      "enabledIndex": 0,
      "url": "^http://localhost:3000/api/users(?:\\?.*)?$",
      "matchType": "regex",
      "method": "GET",
      "pageScope": "specified",
      "pageUrlRules": [
        {
          "id": "page-local",
          "matchType": "exact",
          "value": "http://localhost:3000"
        }
      ],
      "statusCode": 200,
      "responseDelay": 0,
      "responseBody": "{}",
      "responseContentType": "application/json; charset=utf-8",
      "responseBodyMode": "dynamic",
      "requestHeaderRules": [],
      "queryParamRules": [],
      "responseHeaderRules": [],
      "preserveRedirectQuery": true,
      "pipeline": {
        "request": {
          "headers": false,
          "data": false
        },
        "route": {
          "mode": "origin"
        },
        "response": {
          "mode": "mock",
          "headers": false,
          "delay": false
        }
      },
      "sort": 3,
      "hitCount": 0,
      "source": "manual",
      "createTime": 1788912000000,
      "updateTime": 1788912000000,
      "responseScript": "async function generateResponse(request) {\n  const page = Math.max(1, Math.floor(Number(request.query.page) || 1));\n  const pageSize = 2;\n  const users = [\n    { id: 1, name: \"Avery\" },\n    { id: 2, name: \"Riley\" },\n    { id: 3, name: \"Morgan\" },\n    { id: 4, name: \"Casey\" },\n    { id: 5, name: \"Jordan\" }\n  ];\n  return { page, pageSize, total: users.length,\n    items: users.slice((page - 1) * pageSize, page * pageSize) };\n}"
    }
  ],
  "pageScripts": []
}
