          "createTime": 1788912000000,
          "updateTime": 1788912000000,
          "responseScript": "async function generateResponse(request) {\n  const page = Math.max(1, Math.floor(Number(request.query.page) || 1));\n  const pageSize = 2;\n  const users = [\n    { id: 1, name: \"Avery\" },\n    { id: 2, name: \"Riley\" },\n    { id: 3, name: \"Morgan\" },\n    { id: 4, name: \"Casey\" },\n    { id: 5, name: \"Jordan\" }\n  ];\n  return { page, pageSize, total: users.length,\n    items: users.slice((page - 1) * pageSize, page * pageSize) };\n}"
        },
